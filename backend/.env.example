# AI Configuration
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# Database
DATABASE_URL=sqlite+aiosqlite:///./deepaudit.db

# Redis
REDIS_URL=redis://localhost:6379/0

# File Upload
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
MAX_FILE_SIZE=104857600

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
